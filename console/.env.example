# SliderAPI 控制台环境变量
# 复制为 .env 后按需修改；server.js 启动时会自动读取同目录下的 .env
# （已存在的真实环境变量优先级更高）

# 控制台监听端口
PORT=3000

# 监听地址（0.0.0.0 允许局域网访问，127.0.0.1 仅本机）
HOST=0.0.0.0

# 上游 new-api 地址（控制台会把 /api/* 反代到这里）
NEWAPI_BASE=http://localhost:3001

# —— 数据迁移（/migrate 页面）——
# 迁移工具目录（默认为 ../migrate，即 SliderAPI 仓库里的 migrate/）
# MIGRATE_DIR=C:\Users\you\Desktop\SliderAPI\migrate

# 迁移数据目录（导出包、上传包、导入前备份都放这里）
# MIGRATE_DATA_DIR=./migrate-data

# 可选：脚本化访问 /migrate/api 的静态令牌。
# 不设置时，接口只认 new-api 管理员会话（role>=10）；设置后请求需带 x-migrate-token 头。
# MIGRATE_TOKEN=

# 上传迁移包的大小上限（字节，默认 2GB）
# MIGRATE_MAX_UPLOAD=2147483648